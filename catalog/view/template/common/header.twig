<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{ title }}</title>
  <base href="{{ base }}"/>
  {% if icon %}
    <link rel="icon" type="image/x-icon" href="{{ icon }}"/>
  {% endif %}
  {% if description %}
    <meta name="description" content="{{ description }}"/>
  {% endif %}
  <link rel="canonical" href="{{ canonical|raw }}"/>
  <meta name="robots" content="index, follow"/>
  <meta name="google-site-verification" content="IhzC9ki2Fzzeqi2ccQX8n6LeMuctfB2bXit7yAHy41k"/>
  <meta property="og:type" content="{{ og_type|default('website') }}"/>
  <meta property="og:site_name" content="{{ name }}"/>
  <meta property="og:title" content="{{ title }}"/>
  {% if description %}
    <meta property="og:description" content="{{ description }}"/>
  {% endif %}
  <meta property="og:url" content="{{ canonical|raw }}"/>
  <meta property="og:locale" content="tr_TR"/>
  {% if og_image %}
    <meta property="og:image" content="{{ og_image }}"/>
    <meta property="twitter:image" content="{{ og_image }}"/>
  {% elseif logo %}
    <meta property="og:image" content="{{ logo }}"/>
  {% endif %}
  <meta name="twitter:card" content="summary"/>
  <meta name="twitter:title" content="{{ title }}"/>
  <meta name="twitter:description" content="{{ description }}"/>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ name }}",
    "url": "{{ base }}",
    {% if logo %}"logo": "{{ logo }}",{% endif %}
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "{{ telephone }}",
      "contactType": "customer service",
      "availableLanguage": ["Turkish"]
    }
  }
  </script>
  <script src="{{ jquery }}" type="text/javascript"></script>
  <link href="{{ bootstrap }}" type="text/css" rel="stylesheet" media="screen"/>
  <link href="{{ icons }}" type="text/css" rel="stylesheet"/>
  <link rel="stylesheet" href="catalog/view/stylesheet/bootstrap-icons.css"/>
  <link href="{{ stylesheet }}" type="text/css" rel="stylesheet"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://unpkg.com/lenis@1.3.27/dist/lenis.css"/>
  {% for style in styles %}
    <link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}"/>
  {% endfor %}
  {% for script in scripts %}
    <script src="{{ script.href }}" type="text/javascript"></script>
  {% endfor %}
  <script src="catalog/view/javascript/common.js" type="text/javascript"></script>
  <script src="https://unpkg.com/lenis@2.0.1/dist/lenis.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js" defer></script>
  <script src="catalog/view/javascript/modern.js" type="text/javascript"></script>
  {% for link in links %}
    <link href="{{ link.href }}" rel="{{ link.rel }}"/>
  {% endfor %}
  {% for analytic in analytics %}
    {{ analytic }}
  {% endfor %}
</head>
<body class="modern-storefront">
<div id="alert" class="position-fixed top-0 end-0 p-3" style="z-index: 9999; pointer-events: none;"></div>

<div class="drawer-overlay" id="drawerOverlay" aria-hidden="true"></div>

<header class="site-header">
  <div class="container header-inner">
    <button class="menu-toggle" id="menuToggle" aria-label="Menüyü aç/kapa" aria-expanded="false" aria-controls="siteNav">
      <span></span><span></span><span></span>
    </button>
    <a class="site-logo" href="{{ home }}" aria-label="{{ name }}"><img class="site-logo-img" src="{{ base }}image/catalog/logo.png" alt="{{ name }}" width="40" height="40" loading="eager"/><span>{{ name }}</span></a>

    <nav class="main-nav" id="siteNav" aria-label="Ana menü">
      <div class="mobile-drawer-head">
        <a class="site-logo logo-drawer" href="{{ home }}"><img class="site-logo-img" src="{{ base }}image/catalog/logo.png" alt="{{ name }}" width="32" height="32" loading="eager"/><span>{{ name }}</span></a>
        <button type="button" class="mobile-close" id="menuClose" aria-label="Menüyü kapat"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="mobile-drawer-search">{{ search }}</div>
      {{ menu }}
      <ul class="mobile-quick-links">
        <li><a href="{{ account }}"><i class="fa-regular fa-user"></i> {{ text_account }}</a></li>
        <li><a href="{{ wishlist }}"><i class="fa-regular fa-heart"></i> {{ text_wishlist }}</a></li>
        <li><a href="{{ checkout }}"><i class="fa-solid fa-box-arrow-right"></i> {{ text_checkout }}</a></li>
      </ul>
    </nav>

    <div class="header-search" id="headerSearchWrap">{{ search }}</div>
    <div class="header-actions">
      <button class="header-icon header-search-toggle" id="searchToggle" type="button" aria-label="Ara" aria-expanded="false"><i class="fas fa-search"></i></button>

      <div class="dropdown header-account">
        <button type="button" class="header-icon dropdown-toggle" id="accountDropdown" data-bs-toggle="dropdown" aria-label="Hesabım"><i class="fa-solid fa-user"></i></button>
        <div class="dropdown-menu dropdown-menu-end header-account-menu" aria-labelledby="accountDropdown">
          {% if not logged %}
            <a href="{{ login }}" class="dropdown-item"><i class="fa-solid fa-right-to-bracket me-2"></i>{{ text_login }}</a>
            <a href="{{ register }}" class="dropdown-item"><i class="fa-solid fa-user-plus me-2"></i>{{ text_register }}</a>
            <div class="dropdown-divider"></div>
          {% else %}
            <a href="{{ account }}" class="dropdown-item"><i class="fa-regular fa-user me-2"></i>{{ text_account }}</a>
            <a href="{{ order }}" class="dropdown-item"><i class="fa-solid fa-box-archive me-2"></i>{{ text_order }}</a>
            <div class="dropdown-divider"></div>
          {% endif %}
          <a href="{{ wishlist }}" class="dropdown-item"><i class="fa-regular fa-heart me-2"></i>{{ text_wishlist }}</a>
          {% if logged %}<a href="{{ logout }}" class="dropdown-item"><i class="fa-solid fa-right-from-bracket me-2"></i>{{ text_logout }}</a>{% endif %}
        </div>
      </div>

      {{ cart }}

      {{ language }}
    </div>
  </div>
  <div class="header-search-bar" id="headerSearchBar"><div class="container">{{ search }}</div></div>
</header>

<main class="site-main">
