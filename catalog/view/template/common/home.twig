{{ header }}
<div id="common-home" class="page-home">
  <section class="home-hero container-fluid px-0">
    {% if slides %}
      <div class="container">
        <div class="home-hero-slider" id="homeHeroSlider" aria-label="Hero">
          {% for slide in slides %}
            <div class="home-hero-slide{% if loop.first %} active{% endif %}" style="background-image: url('{{ slide.image }}')">
              <div class="home-hero-overlay"></div>
              <div class="home-hero-slide-inner">
                <p class="eyebrow">Mevsim Yöresel</p>
                <h1 class="home-hero-title">{{ slide.title ?: 'Doğal katkısız yöresel ürünler, üreticiden direkt kapınızda.' }}</h1>
                <p class="home-hero-sub">{{ slide.subtext ?: hero_subtext ?: 'Kahramanmaraş’ın usta üreticilerinden seçkin, doğal ve katkısız yöresel ürünler.' }}</p>
                {% if slide.link %}<a href="{{ slide.link }}" class="btn btn-primary home-hero-cta">Keşfet</a>{% endif %}
              </div>
            </div>
          {% endfor %}
          {% if slides|length > 1 %}
            <button class="home-hero-arrow home-hero-arrow-prev" type="button" aria-label="Önceki slayt"><i class="fas fa-chevron-left"></i></button>
            <button class="home-hero-arrow home-hero-arrow-next" type="button" aria-label="Sonraki slayt"><i class="fas fa-chevron-right"></i></button>
            <div class="home-hero-dots" role="tablist" aria-label="Slayt seç">
              {% for slide in slides %}
                <button class="home-hero-dot{% if loop.first %} active{% endif %}" type="button" data-slide="{{ loop.index0 }}" aria-label="Slayt {{ loop.index }}"></button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
      <script type="text/javascript"><!--
        (function(){
          var slider = document.getElementById('homeHeroSlider');
          if (!slider) return;
          var slides = slider.querySelectorAll('.home-hero-slide');
          var dots = slider.querySelectorAll('.home-hero-dot');
          var current = 0, timer = null;
          function go(i){
            current = (i + slides.length) % slides.length;
            slides.forEach(function(s, idx){ s.classList.toggle('active', idx === current); });
            dots.forEach(function(d, idx){ d.classList.toggle('active', idx === current); });
          }
          function next(){ go(current + 1); }
          function restart(){
            clearInterval(timer);
            if (slides.length > 1) timer = setInterval(next, 5000);
          }
          slider.addEventListener('mouseenter', function(){ clearInterval(timer); });
          slider.addEventListener('mouseleave', restart);
          var prev = slider.querySelector('.home-hero-arrow-prev');
          var nxt = slider.querySelector('.home-hero-arrow-next');
          if (prev) prev.addEventListener('click', function(){ go(current - 1); restart(); });
          if (nxt) nxt.addEventListener('click', function(){ go(current + 1); restart(); });
          dots.forEach(function(d){
            d.addEventListener('click', function(){ go(parseInt(d.getAttribute('data-slide'), 10)); restart(); });
          });
          // Mobilde kaydırma ile slayt değiştirme
          var touchStartX = 0, touchStartY = 0;
          slider.addEventListener('touchstart', function(e){
            if (!e.touches.length) return;
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
          }, { passive: true });
          slider.addEventListener('touchend', function(e){
            if (!e.changedTouches.length) return;
            var dx = e.changedTouches[0].clientX - touchStartX;
            var dy = e.changedTouches[0].clientY - touchStartY;
            if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2) {
              go(current + (dx < 0 ? 1 : -1));
              restart();
            }
          }, { passive: true });
          restart();
        })();
      //--></script>
    {% else %}
      <div class="container home-hero-inner">
        <div class="home-hero-copy" data-modern-reveal>
          <p class="eyebrow">Mevsim Yöresel</p>
          <h1 class="home-hero-title">Doğal katkısız yöresel ürünler, üreticiden direkt kapınızda.</h1>
          <p class="home-hero-sub">Kahramanmaraş'ın usta üreticilerinden seçkin, doğal ve katkısız yöresel ürünler.</p>
        </div>
      </div>
    {% endif %}
  </section>
  <div class="container home-trust-wrap">
    {% include 'catalog/view/template/common/trust.twig' %}
  </div>
  {% if categories_with_images %}
    <div class="container home-cats-wrap">
      <div class="home-cats-grid">
        {% for cat in categories_with_images %}
          <a href="{{ cat.href }}" class="home-cat" title="{{ cat.name }}">
            {% if cat.image %}<span class="home-cat-img"><img src="{{ cat.image }}" alt="{{ cat.name }}" loading="lazy"/></span>{% else %}<span class="home-cat-img home-cat-fallback"><i class="fa-solid fa-tag"></i></span>{% endif %}
            <span class="home-cat-name">{{ cat.name }}</span>
          </a>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="container home-content-wrap home-featured-wrap">
    <div class="row">{{ column_left }}
      <div id="content" class="col">{{ content_top }}</div>
      {{ column_right }}</div>
  </div>

  {% include 'catalog/view/template/common/home_story.twig' %}
  {% include 'catalog/view/template/common/trust_why.twig' %}
  {% include 'catalog/view/template/common/home_steps.twig' %}

  <div class="container home-content-wrap home-bottom-wrap">
    <div class="row">
      <div class="col">{{ content_bottom }}</div>
    </div>
  </div>
</div>
{{ footer }}