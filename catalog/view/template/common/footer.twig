<script>
  (function () {
    var form = document.getElementById('form-newsletter');

    if (!form) {
      return;
    }

    var result = document.getElementById('newsletter-result');

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      result.textContent = '';
      result.className = 'footer-gt-result';

      fetch(form.getAttribute('action'), {
        method: 'POST',
        body: new FormData(form),
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      })
        .then(function (response) { return response.json(); })
        .then(function (json) {
          if (json && json.success) {
            result.textContent = json.success;
            result.classList.add('is-success');
            form.reset();
          } else {
            var message = '';

            if (json && json.error) {
              if (json.error.warning) {
                message = json.error.warning;
              } else {
                message = Object.keys(json.error).map(function (key) { return json.error[key]; }).join(' ');
              }
            }

            result.textContent = message || 'Bir hata oluştu. Lütfen tekrar deneyin.';
            result.classList.add('is-error');
          }
        })
        .catch(function () {
          result.textContent = 'Bir hata oluştu. Lütfen tekrar deneyin.';
          result.classList.add('is-error');
        });
    });
  })();
</script>
