{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-shipping" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-shipping" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-divisor" class="col-sm-2 col-form-label">{{ entry_divisor }}</label>
            <div class="col-sm-10">
              <input type="number" step="any" min="0.01" name="shipping_desi_weight_divisor" value="{{ shipping_desi_weight_divisor }}" placeholder="{{ entry_divisor }}" id="input-divisor" class="form-control"/>
              <div class="form-text text-muted">{{ help_divisor }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-desi-rates" class="col-sm-2 col-form-label">{{ entry_desi_rates }}</label>
            <div class="col-sm-10">
              <textarea name="shipping_desi_weight_desi_rates" rows="5" placeholder="{{ entry_desi_rates }}" id="input-desi-rates" class="form-control">{{ shipping_desi_weight_desi_rates }}</textarea>
              <div class="form-text text-muted">{{ help_desi_rates }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-kg-rate" class="col-sm-2 col-form-label">{{ entry_kg_rate }}</label>
            <div class="col-sm-10">
              <input type="number" step="any" min="0" name="shipping_desi_weight_kg_rate" value="{{ shipping_desi_weight_kg_rate }}" placeholder="{{ entry_kg_rate }}" id="input-kg-rate" class="form-control"/>
              <div class="form-text text-muted">{{ help_kg_rate }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-max-cost" class="col-sm-2 col-form-label">{{ entry_max_cost }}</label>
            <div class="col-sm-10">
              <input type="number" step="any" min="0" name="shipping_desi_weight_max_cost" value="{{ shipping_desi_weight_max_cost }}" placeholder="{{ entry_max_cost }}" id="input-max-cost" class="form-control"/>
              <div class="form-text text-muted">{{ help_max_cost }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-supplier-map" class="col-sm-2 col-form-label">{{ entry_supplier_map }}</label>
            <div class="col-sm-10">
              <textarea name="shipping_desi_weight_supplier_map" rows="3" placeholder="{{ entry_supplier_map }}" id="input-supplier-map" class="form-control">{{ shipping_desi_weight_supplier_map }}</textarea>
              <div class="form-text text-muted">{{ help_supplier_map }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-tax-class" class="col-sm-2 col-form-label">{{ entry_tax_class }}</label>
            <div class="col-sm-10">
              <select name="shipping_desi_weight_tax_class_id" id="input-tax-class" class="form-select">
                <option value="0">{{ text_none }}</option>
                {% for tax_class in tax_classes %}
                  <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == shipping_desi_weight_tax_class_id %} selected{% endif %}>{{ tax_class.title }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="shipping_desi_weight_status" value="0"/>
                <input type="checkbox" name="shipping_desi_weight_status" value="1" id="input-status" class="form-check-input"{% if shipping_desi_weight_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_desi_weight_sort_order" value="{{ shipping_desi_weight_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-10 offset-sm-2">
              <div class="alert alert-info mb-0">{{ help_calculation }}</div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
