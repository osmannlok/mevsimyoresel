{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <div class="alert alert-info">{{ text_api_hint }}</div>
        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-merchant-id" class="col-sm-2 col-form-label">{{ entry_merchant_id }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_paytr_merchant_id" value="{{ payment_paytr_merchant_id }}" placeholder="{{ entry_merchant_id }}" id="input-merchant-id" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-merchant-key" class="col-sm-2 col-form-label">{{ entry_merchant_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_paytr_merchant_key" value="{{ payment_paytr_merchant_key }}" placeholder="{{ entry_merchant_key }}" id="input-merchant-key" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-merchant-salt" class="col-sm-2 col-form-label">{{ entry_merchant_salt }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_paytr_merchant_salt" value="{{ payment_paytr_merchant_salt }}" placeholder="{{ entry_merchant_salt }}" id="input-merchant-salt" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_test_mode }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_paytr_test_mode" value="0"/>
                <input type="checkbox" name="payment_paytr_test_mode" value="1" id="input-test-mode" class="form-check-input"{% if payment_paytr_test_mode %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_debug_on }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_paytr_debug_on" value="0"/>
                <input type="checkbox" name="payment_paytr_debug_on" value="1" id="input-debug-on" class="form-check-input"{% if payment_paytr_debug_on %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_no_installment }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_paytr_no_installment" value="0"/>
                <input type="checkbox" name="payment_paytr_no_installment" value="1" id="input-no-installment" class="form-check-input"{% if payment_paytr_no_installment %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-max-installment" class="col-sm-2 col-form-label">{{ entry_max_installment }}</label>
            <div class="col-sm-10">
              <input type="number" name="payment_paytr_max_installment" value="{{ payment_paytr_max_installment }}" placeholder="{{ entry_max_installment }}" id="input-max-installment" class="form-control" min="0" max="12"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-timeout-limit" class="col-sm-2 col-form-label">{{ entry_timeout_limit }}</label>
            <div class="col-sm-10">
              <input type="number" name="payment_paytr_timeout_limit" value="{{ payment_paytr_timeout_limit }}" placeholder="{{ entry_timeout_limit }}" id="input-timeout-limit" class="form-control" min="1" max="60"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-order-status" class="col-sm-2 col-form-label">{{ entry_order_status }}</label>
            <div class="col-sm-10">
              <select name="payment_paytr_order_status_id" id="input-order-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_paytr_order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-fail-status" class="col-sm-2 col-form-label">{{ entry_fail_status }}</label>
            <div class="col-sm-10">
              <select name="payment_paytr_fail_status_id" id="input-fail-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_paytr_fail_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-total" class="col-sm-2 col-form-label">{{ entry_total }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_paytr_total" value="{{ payment_paytr_total }}" placeholder="{{ entry_total }}" id="input-total" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_paytr_status" value="0"/>
                <input type="checkbox" name="payment_paytr_status" value="1" id="input-status" class="form-check-input"{% if payment_paytr_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_paytr_sort_order" value="{{ payment_paytr_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
